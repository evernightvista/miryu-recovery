msgid "Miryu Recovery"
msgstr "Miryu 복구"

msgid "Btrfs snapshot started successfully"
msgstr "Btrfs 스냅숏이 성공적으로 시작되었습니다"

msgid "You are running Btrfs snapshot #%1. To make this snapshot permanent, click 'Rollback Snapshot'. Otherwise, keep the snapshot for this boot."
msgstr "현재 Btrfs 스냅숏 #%1에서 실행 중입니다. 이 스냅숏을 영구적으로 복원하려면 '스냅숏 롤백'을 클릭하세요. 그렇지 않으면 이번 부팅에서만 스냅숏을 유지합니다."

msgid "Rollback Snapshot"
msgstr "스냅숏 롤백"

msgid "Keep Snapshot"
msgstr "스냅숏 유지"

msgid "Snapshot rollback completed"
msgstr "스냅숏 롤백 완료"

msgid "Restart your computer now to finish rolling back the snapshot."
msgstr "스냅숏 롤백을 완료하려면 지금 컴퓨터를 다시 시작하세요."

msgid "Restart Now"
msgstr "지금 다시 시작"

msgid "Snapshot rollback failed"
msgstr "스냅숏 롤백 실패"

msgid "The snapshot could not be restored. Check the system state before restarting."
msgstr "스냅숏을 복원할 수 없습니다. 다시 시작하기 전에 시스템 상태를 확인하세요."

msgid "Authentication failed or was cancelled."
msgstr "인증에 실패했거나 취소되었습니다."
